 <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_add_task" android:tint="@color/wp_on_primary" />
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Task" android:textSize="12sp" android:textColor="@color/wp_on_primary" /></LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:background="@drawable/wp_bg_tonal" android:gravity="center" android:orientation="vertical">
 <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_payments" android:tint="@color/wp_on_tonal" />
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Expense" android:textSize="12sp" android:textColor="@color/wp_on_tonal" /></LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:background="@drawable/wp_bg_tonal" android:gravity="center" android:orientation="vertical">
